# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semantic_search

# Embedding model (local, free, no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: set to true and provide a key to use OpenAI embeddings instead
USE_OPENAI_EMBEDDINGS=false
OPENAI_API_KEY=

# Frontend origin allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]
